// 测试基本语法特性
fn main() {
    // 变量声明
    let x: int = 10;
    const y: float = 3.14;
    
    // 基本运算
    let result: int = x + 5;
    let condition: bool = x > 5 && y < 10.0;
    
    // 控制流
    if (x > 0) {
        println("x is positive");
    } else {
        println("x is non-positive");
    }
    
    // 循环
    for (let i: int = 0; i < 10; i = i + 1) {
        println("i = ", i);
    }
    
    // 函数调用
    let sum: int = add(x, 5);
    
    // 异步函数示例
    async fn fetch_data(url: string) -> Result<string, Error> {
        // 异步操作
        return Ok("data");
    }
}

// 辅助函数
fn add(a: int, b: int) -> int {
    return a + b;
}

// 泛型函数示例
fn identity<T>(value: T) -> T {
    return value;
}

// 匹配语句示例
fn process_result(result: Result<int, string>) -> int {
    match (result) {
        Ok(value) => { return value; },
        Err(error) => { 
            println("Error: ", error);
            return -1; 
        }
    }
}